root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
# LF, not DiskAnalyzer's CRLF: MindBuzz is developed on macOS as well (NFR §5.3). .gitattributes agrees.
end_of_line = lf

[*.{csproj,props,targets,axaml,xaml,json,slnx,yml,yaml,resx,manifest,plist}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = false:none

# CA1303 wants literals moved to resources. Strings.resx already does that by design, and the
# remaining literals are diagnostics (stderr) or file-format keys, which must not be translated.
dotnet_diagnostic.CA1303.severity = none

# CA1822 (member can be static) is a micro-optimisation; public entry points stay instance
# methods so they can be substituted in tests and the UI.
dotnet_diagnostic.CA1822.severity = suggestion

# CA1863 wants cached CompositeFormat instances, but every format string here comes from
# Strings.resx and changes with the UI culture, so caching them would defeat i18n.
dotnet_diagnostic.CA1863.severity = none
