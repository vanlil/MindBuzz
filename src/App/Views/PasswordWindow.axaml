<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:MindBuzz.App.Services"
        xmlns:loc="using:MindBuzz.App.Localization"
        x:Class="MindBuzz.App.Views.PasswordWindow"
        x:DataType="services:PasswordRequest"
        Title="{Binding WindowTitle}"
        Icon="/Assets/MindBuzz.ico"
        CanMinimize="False"
        CanMaximize="False"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

  <!-- A password to open or unlock an encrypted file, or a new one typed twice. -->
  <Border Padding="24,20" Background="{DynamicResource AppSurfaceBrush}">
    <StackPanel Spacing="14">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <Path Classes="icon" VerticalAlignment="Center" Width="18" Height="18" Data="{StaticResource IconLock}" />
        <TextBlock Classes="title" VerticalAlignment="Center" Text="{Binding WindowTitle}" />
      </StackPanel>

      <TextBlock TextWrapping="Wrap" Text="{Binding Message}" />

      <StackPanel Spacing="6">
        <Label Target="PasswordBox" Content="{x:Static loc:Strings.Password_Label}" />
        <Border Classes="fieldShadow">
          <TextBox x:Name="PasswordBox" PasswordChar="●" RevealPassword="False" />
        </Border>
      </StackPanel>

      <StackPanel Spacing="6" IsVisible="{Binding IsNew}">
        <Label Target="RepeatBox" Content="{x:Static loc:Strings.Password_Repeat}" />
        <Border Classes="fieldShadow">
          <TextBox x:Name="RepeatBox" PasswordChar="●" RevealPassword="False" />
        </Border>
      </StackPanel>

      <TextBlock x:Name="Hint" Classes="caption" TextWrapping="Wrap" />

      <!-- Said every time a password is set: there is no way back without it. -->
      <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsNew}" Text="{x:Static loc:Strings.Password_Warning}" />

      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
        <Button x:Name="CancelButton" MinWidth="88" IsCancel="True" Content="{x:Static loc:Strings.Answer_Cancel}" />
        <Button x:Name="OkButton" MinWidth="88" IsDefault="True" Classes="Primary" Theme="{DynamicResource SolidButton}" Content="{Binding OkLabel}" />
      </StackPanel>
    </StackPanel>
  </Border>

</Window>
